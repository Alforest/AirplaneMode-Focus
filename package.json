{
  "name": "focusflight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsx scripts/prerenderLanding.tsx",
    "preview": "vite preview",
    "data:airports": "tsx scripts/buildAirports.ts",
    "data:routes": "tsx scripts/buildAirlineRoutes.ts",
    "test:history": "tsx --test tests/history.test.ts",
    "test:stats": "tsx --test tests/personalStats.test.ts",
    "test:goals": "tsx --test tests/weeklyGoals.test.ts",
    "test:analytics": "tsx --test tests/analyticsIdentity.test.ts",
    "test:recovery": "tsx --test tests/flightRecovery.test.ts",
    "test:camera": "tsx --test tests/followCamera.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "framer-motion": "^10.18.0",
    "mapbox-gl": "^3.10.0",
    "posthog-js": "^1.396.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/mapbox-gl": "^3.4.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^4.5.5"
  }
}
